{
  "name": "pi-theme-pina",
  "version": "0.1.0",
  "description": "Piña — a TUI experience package for the Pi coding agent: themes plus interface extensions",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-theme",
    "theme"
  ],
  "files": [
    "themes",
    "extensions",
    "src",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "themes": [
      "themes/*.json"
    ],
    "extensions": [
      "extensions/index.ts"
    ]
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
